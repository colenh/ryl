# Copy this file to .env and fill in your values.

# Supabase project URL and publishable key, always required
# Find yours at: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Mapbox public token, only required if features.addressAutocomplete is true in config.ts
# Get yours at https://mapbox.com, free up to 100K requests/month, credit card required but not charged until exceeded
# Sign up → Dashboard → Tokens → Create a new token → Choose any name → Leave public scopes enabled (no others needed)
# → Add your RYL site url and "http://localhost:5173" to URLs → Copy the token
VITE_MAPBOX_TOKEN="pk.your_token_here"

# Formspree form endpoint, only required if features.contactForm is true in config.ts
# Get yours at https://formspree.io (free account, create a form, copy the endpoint URL)
VITE_FORMSPREE_URL="https://formspree.io/f/your-form-id"

# Cloudflare Turnstile site key, only required if features.turnstile is true in config.ts
# Get yours at https://dash.cloudflare.com (Zero Trust > Turnstile, create a site, copy the Site Key)
# Use 1x00000000000000000000AA for always-pass testing
VITE_TURNSTILE_SITE_KEY="your-site-key"
